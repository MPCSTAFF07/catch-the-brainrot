[Unit]
Description=Catch the Brainrot Discord bot and dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/catch-the-brainrot
ExecStart=/home/ubuntu/catch-the-brainrot/.venv/bin/python /home/ubuntu/catch-the-brainrot/dashboard.py
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
